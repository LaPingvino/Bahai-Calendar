<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Row: Star icon, Weekday, Live Clock, and Sunset Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_star_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Badí\' Emblem"
            android:src="@drawable/ic_star_9" />

        <TextView
            android:id="@+id/widget_badi_weekday"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Kamál • Monday"
            android:textColor="#E0E1DD"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Live Clock -->
        <TextClock
            android:id="@+id/widget_text_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:format12Hour="h:mm a"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_sunset_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#26FFD54F"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="☀️ BEFORE SUNSET"
            android:textColor="#FFE082"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Date Display: "17 Asmá' 183 B.E." -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_badi_day_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="17"
            android:textColor="#FFD54F"
            android:textSize="30sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_badi_month_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Asmá\' 183 B.E."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_badi_translation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Month of Names • Váḥid 10"
                android:textColor="#B0C4DE"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Location & Solar Times -->
    <TextView
        android:id="@+id/widget_location_solar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="📍 Haifa • 🌅 5:42 AM • 🌇 7:48 PM"
        android:textColor="#B2EBF2"
        android:textSize="10sp" />

    <!-- Today's Upcoming Event Row -->
    <LinearLayout
        android:id="@+id/widget_event_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#20FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/widget_event_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="📅 3:00 PM Devotional Meeting"
            android:textColor="#E0E1DD"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Row: Gregorian Date & Holy Day / Feast Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_gregorian_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mon, Aug 17, 2026"
            android:textColor="#90E0EF"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_holy_day_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#33FFB74D"
            android:paddingStart="6dp"
            android:paddingTop="1dp"
            android:paddingEnd="6dp"
            android:paddingBottom="1dp"
            android:text="Feast of Asmá\'"
            android:textColor="#FFCC80"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:visibility="visible" />
    </LinearLayout>
</LinearLayout>
