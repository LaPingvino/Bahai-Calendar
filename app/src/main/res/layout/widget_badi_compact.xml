<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_badi_day_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="17"
        android:textColor="#FFD54F"
        android:textSize="28sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_badi_month_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Asmá\' 183 B.E."
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_badi_weekday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kamál • Monday"
            android:textColor="#B0C4DE"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_sunset_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#26FFD54F"
            android:paddingStart="5dp"
            android:paddingTop="2dp"
            android:paddingEnd="5dp"
            android:paddingBottom="2dp"
            android:text="☀️ BEFORE SUNSET"
            android:textColor="#FFE082"
            android:textSize="8.5sp"
            android:textStyle="bold" />

        <TextClock
            android:id="@+id/widget_text_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:format12Hour="h:mm a"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Live Native Elemental Time -->
        <LinearLayout
            android:id="@+id/widget_etime_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_etime_prefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💧 2:"
                android:textColor="#80DEEA"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextClock
                android:id="@+id/widget_etime_minute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:timeZone="UTC"
                android:format12Hour="mm"
                android:format24Hour="mm"
                android:textColor="#80DEEA"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
