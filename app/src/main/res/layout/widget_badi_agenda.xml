<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Header: Badí' Date, Live Clock, Sunset & Location -->
    <LinearLayout
        android:id="@+id/widget_container_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_star_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Badí\' Emblem"
            android:src="@drawable/ic_star_9" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_badi_month_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17 Asmá\' 183 B.E."
                android:textColor="#FFD54F"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_location_solar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Haifa • 🌅 5:42 AM • 🌇 7:48 PM"
                android:textColor="#B2EBF2"
                android:textSize="9.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/widget_text_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm a"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_sunset_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:background="#26FFD54F"
                android:paddingStart="5dp"
                android:paddingTop="1dp"
                android:paddingEnd="5dp"
                android:paddingBottom="1dp"
                android:text="☀️ BEFORE SUNSET"
                android:textColor="#FFE082"
                android:textSize="8.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="4dp"
        android:background="#26FFFFFF" />

    <!-- Agenda Title & Badges Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_agenda_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Upcoming Appointments &amp; Events"
            android:textColor="#E0E1DD"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_holy_day_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#33FFB74D"
            android:paddingStart="5dp"
            android:paddingTop="1dp"
            android:paddingEnd="5dp"
            android:paddingBottom="1dp"
            android:text="Feast of Asmá\'"
            android:textColor="#FFCC80"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Scrollable Agenda ListView -->
    <ListView
        android:id="@+id/widget_agenda_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="4dp"
        android:scrollbars="vertical" />

    <!-- Empty State View -->
    <LinearLayout
        android:id="@+id/widget_agenda_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:id="@+id/widget_agenda_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="📅 No upcoming appointments\nTap to add in Google Calendar"
            android:textColor="#90E0EF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Footer: Gregorian date & prompt -->
    <TextView
        android:id="@+id/widget_gregorian_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Monday, August 17, 2026 • Tap to open app"
        android:textColor="#B0C4DE"
        android:textSize="9sp" />
</LinearLayout>
