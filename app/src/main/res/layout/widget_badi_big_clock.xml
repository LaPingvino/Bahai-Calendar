<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Row: Big Live Digital Clock & Sunset Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextClock
            android:id="@+id/widget_text_clock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:format12Hour="h:mm a"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_sunset_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#26FFD54F"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="☀️ BEFORE SUNSET"
                android:textColor="#FFE082"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_badi_weekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Kamál • Monday"
                android:textColor="#B0C4DE"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Middle: Badí' Date & Solar Information -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_badi_full_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="17 Asmá' 183 B.E."
            android:textColor="#FFD54F"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_location_solar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 Haifa • 🌇 7:48 PM"
            android:textColor="#B2EBF2"
            android:textSize="9.5sp" />
    </LinearLayout>

    <!-- Holy Day badge if active -->
    <TextView
        android:id="@+id/widget_holy_day_badge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:background="#33FFB74D"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:text="✨ Holy Day: Declaration of the Báb"
        android:textColor="#FFCC80"
        android:textSize="9.5sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 3 Logical Time Blocks & Appointments Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Block 1: Current Block -->
        <LinearLayout
            android:id="@+id/widget_block_1_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#15FFFFFF"
            android:orientation="vertical"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_block_1_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Current: ☀️ Daytime Portion"
                    android:textColor="#FFD54F"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_block_1_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5:42 AM – 7:48 PM"
                    android:textColor="#B0C4DE"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_block_1_event"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="📅 10:00 AM Team Sync"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Block 2: +1 Ahead -->
        <LinearLayout
            android:id="@+id/widget_block_2_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="#10FFFFFF"
            android:orientation="vertical"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_block_2_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="+1 Ahead: 🌙 Next Eve Start"
                    android:textColor="#D0BCFF"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_block_2_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7:48 PM – 5:43 AM"
                    android:textColor="#9E9E9E"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_block_2_event"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="📅 8:00 PM Devotional Gathering"
                android:textColor="#E0E1DD"
                android:textSize="9.5sp" />
        </LinearLayout>

        <!-- Block 3: +2 Ahead -->
        <LinearLayout
            android:id="@+id/widget_block_3_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="#0AFFFFFF"
            android:orientation="vertical"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_block_3_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="+2 Ahead: ☀️ Tomorrow Daytime"
                    android:textColor="#80D8FF"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_block_3_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5:43 AM – 7:47 PM"
                    android:textColor="#9E9E9E"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_block_3_event"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Prep: No appointments"
                android:textColor="#B0C4DE"
                android:textSize="9.5sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
